; Tests for Itanium C++ ABI demangling of vendor-extended type qualifiers
; combined with CV qualifiers and substitution back-references.
;
; Vendor-extended qualifiers (U <source-name> <type>) are used in OpenCL/SPIR-V
; to encode address spaces (AS1, AS2, AS3, AS4) and type qualifiers (_Atomic).
; When CV qualifiers appear inside a chain of vendor-extended qualifiers, the
; resulting QualType nodes must be recorded in the substitution table so that
; back-references (S_, S0_, S4_, ...) resolve correctly.

; volatile (V) inside nested vendor-extended qualifier chain AS3(_Atomic(...)).
; U3AS3VU7_Atomici encodes: volatile _Atomic int qualified with AS3.
; The intermediate QualType("volatile _Atomic int") is Subs[1]; S4_ must
; resolve to "memory_order" (Subs[5]), not be out-of-range.
; RUN: llvm-cxxfilt -n _Z37atomic_compare_exchange_weak_explicitPU3AS3VU7_AtomiciPii12memory_orderS4_12memory_scope \
; RUN:   | FileCheck %s --check-prefix=WEAK
; WEAK: atomic_compare_exchange_weak_explicit(int _Atomic volatile AS3*, int*, int, memory_order, memory_order, memory_scope)

; RUN: llvm-cxxfilt -n _Z39atomic_compare_exchange_strong_explicitPU3AS3VU7_AtomiciPii12memory_orderS4_12memory_scope \
; RUN:   | FileCheck %s --check-prefix=STRONG
; STRONG: atomic_compare_exchange_strong_explicit(int _Atomic volatile AS3*, int*, int, memory_order, memory_order, memory_scope)

; const (K) inside a single vendor-extended qualifier.
; S_ resolves to Subs[0] = QualType("int const"), not the VendorExtQualType.
; RUN: llvm-cxxfilt -n _Z1fPU3AS1KiS_ | FileCheck %s --check-prefix=CONST
; CONST: f(int const AS1*, int const)

; restrict (r) inside a single vendor-extended qualifier.
; S_ resolves to Subs[0] = QualType("int restrict").
; RUN: llvm-cxxfilt -n _Z1fPU3AS1riS_ | FileCheck %s --check-prefix=RESTRICT
; RESTRICT: f(int restrict AS1*, int restrict)

; Multiple back-references in one parameter list: S_ = QualType(int, const),
; S0_ = VendorExtQualType(int const, AS1).
; RUN: llvm-cxxfilt -n _Z1fPU3AS1KiS_S0_ | FileCheck %s --check-prefix=MULTI
; MULTI: f(int const AS1*, int const, int const AS1)
